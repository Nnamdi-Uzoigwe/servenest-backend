NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/servenest?retryWrites=true&w=majority
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8081

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30

# Leave SMTP_HOST empty in development and codes print in the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ServeNest <no-reply@servenest.app>